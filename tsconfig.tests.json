{
  /* Projet dédié aux tests hors application : sécurité (supabase/tests) et
     parcours E2E (e2e/).
     Séparé de `tsconfig.node.json` parce que ces fichiers utilisent la
     résolution « bundler » de Vitest, pas celle de Node : sans ça, chaque
     import relatif sans extension serait refusé. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["supabase/tests", "e2e", "playwright.config.ts"]
}
